{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__n8n",
      "mcp__github",
      "mcp__Slack",
      "mcp__Gmail",
      "mcp__Google_Drive",
      "mcp__Google_Calendar",
      "mcp__Claude_Docs",
      "mcp__HubSpot",
      "mcp__Supabase",
      "mcp__Apollo_io",
      "mcp__Vercel",
      "mcp__Granola",
      "mcp__Claude_Code_Remote"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(mkfs*)",
      "Bash(dd if=* of=/dev/*)"
    ]
  }
}
